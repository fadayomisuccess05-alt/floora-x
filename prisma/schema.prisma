enum ActionGroup {
  CLIENT
  PROFESSIONAL
}

enum WalletType {
  CLIENT_POINTS
  PROMO_POINTS
}

enum LedgerReason {
  TOPUP
  SPEND
  REFUND
  BONUS
  ADJUSTMENT
}

enum PaymentCategory {
  POINTS_TOPUP
}

enum PaymentStatus {
  INITIATED
  SUCCESSFUL
  FAILED
}

model ActionPrice {
  action      String      @id
  label       String
  actionGroup ActionGroup
  points      Int
  active      Boolean     @default(true)
  sortOrder   Int         @default(0)
  updatedById String?     @db.Uuid
  updatedAt   DateTime    @updatedAt
}

model CreditPackage {
  id          String  @id @default(cuid())
  points      Int
  priceNaira  Int
  bonusPoints Int     @default(0)
  active      Boolean @default(true)
  sortOrder   Int     @default(0)
}

model Wallet {
  id        String     @id @default(cuid())
  userId    String     @db.Uuid
  type      WalletType @default(CLIENT_POINTS)
  balance   Int        @default(0)
  updatedAt DateTime   @updatedAt

  user    User                @relation(fields: [userId], references: [id])
  entries CreditLedgerEntry[]

  @@unique([userId, type])
}

model CreditLedgerEntry {
  id           String       @id @default(cuid())
  walletId     String
  amount       Int
  balanceAfter Int
  reason       LedgerReason
  action       String?
  refType      String?
  refId        String?
  paymentId    String?
  idemKey      String       @unique
  createdAt    DateTime     @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id])

  @@index([walletId, createdAt])
  @@index([reason, action, createdAt])
}

model Payment {
  id                String          @id @default(cuid())
  userId            String          @db.Uuid
  category          PaymentCategory @default(POINTS_TOPUP)
  amountNaira       Int
  currency          String          @default("NGN")
  provider          String          @default("paystack")
  reference         String          @unique
  providerReference String?
  status            PaymentStatus   @default(INITIATED)
  packageId         String?
  points            Int             @default(0)
  bonusPoints       Int             @default(0)
  paidAt            DateTime?
  createdAt         DateTime        @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model MonetizationChangeLog {
  id         String   @id @default(cuid())
  adminId    String   @db.Uuid
  entityType String
  entityId   String
  oldValue   Json?
  newValue   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  CLIENT
  LANDLORD
  AGENT
  AGENCY
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum AgencyRole {
  OWNER
  ADMINISTRATOR
  AGENT
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

model User {
  id            String        @id @db.Uuid // same ID as the Supabase Auth user
  fullName      String
  email         String        @unique
  phone         String?       @unique
  accountType   AccountType
  accountStatus AccountStatus @default(ACTIVE)
  profilePicture String?
  state         String?
  city          String?
  emailVerified Boolean       @default(false)
  phoneVerified Boolean       @default(false)
  lastLoginAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  agentProfile      AgentProfile?
  landlordProfile   LandlordProfile?
  ownedAgencies     Agency[]
  agencyMemberships AgencyMembership[]
  auditLogs         AuditLog[]  
  verifications     Verification[]
  properties        Property[]
  favorites         Favorite[]
  conversationsAsClient    Conversation[] @relation("ConversationClient")
  conversationsAsRecipient Conversation[] @relation("ConversationRecipient")
  messages                 Message[]
  wallets           Wallet[]
  payments          Payment[]
  notifications     Notification[]
  follows           Follow[]

  @@index([accountType])
}

model AgentProfile {
  id              String   @id @default(cuid())
  userId          String   @unique @db.Uuid
  biography       String?
  yearsExperience Int?
  specialisations String[]
  operatingStates String[]
  operatingCities String[]
  ratingAverage   Float    @default(0)
  totalReviews    Int      @default(0)

  user User @relation(fields: [userId], references: [id])
}

model LandlordProfile {
  id                 String  @id @default(cuid())
  userId             String  @unique @db.Uuid
  residentialAddress String?
  contactPreference  String?

  user User @relation(fields: [userId], references: [id])
}

model Agency {
  id                 String   @id @default(cuid())
  name               String
  companyEmail       String
  companyPhone       String?
  address            String?
  state              String?
  city               String?
  registrationNumber String?
  logo               String?
  description        String?
  website            String?
  ownerUserId        String   @db.Uuid
  createdAt          DateTime @default(now())

  owner       User               @relation(fields: [ownerUserId], references: [id])
  memberships AgencyMembership[]
    properties  Property[]
}

model AgencyMembership {
  id        String           @id @default(cuid())
  agencyId  String
  userId    String           @db.Uuid
  role      AgencyRole
  status    MembershipStatus @default(INVITED)
  invitedAt DateTime         @default(now())
  joinedAt  DateTime?

  agency Agency @relation(fields: [agencyId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([agencyId, userId])
}

// Master switches: trust_enabled, premium_enabled, credits_enabled, boosts_enabled
model FeatureFlag {
  key         String   @id
  enabled     Boolean  @default(false)
  description String?
  updatedById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id             String   @id @default(cuid())
  actorId        String?  @db.Uuid
  action         String
  entityType     String
  entityId       String
  previousValues Json?
  newValues      Json?
  ipAddress      String?
  createdAt      DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId])
}

enum VerificationType {
  NIN
  ADDRESS
  CAC
}

enum VerificationMethod {
  MANUAL
  PROVIDER
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

model Verification {
  id              String             @id @default(cuid())
  userId          String             @db.Uuid
  type            VerificationType
  method          VerificationMethod @default(MANUAL)
  status          VerificationStatus @default(PENDING)
  maskedValue     String?            // e.g. "*******1234"
    submittedAddress String?
  valueHash       String?            // keyed hash of the NIN, to block one NIN on many accounts
  challengeCode   String?            // the random code the person says in the video
  rejectionReason String?
  reviewedById    String?            @db.Uuid
  reviewedAt      DateTime?
  verifiedAt      DateTime?
  expiresAt       DateTime?          // address badge: 12 months
  createdAt       DateTime           @default(now())

  user     User                   @relation(fields: [userId], references: [id])
  evidence VerificationEvidence[]

  @@index([userId, type])
  @@index([status, type])
  @@index([valueHash])
}

model VerificationEvidence {
  id             String   @id @default(cuid())
  verificationId String
  kind           String   // NIN_CARD_FRONT | NIN_CARD_BACK | NIN_VIDEO | UTILITY_BILL | CAC_CERT
  storageKey     String   // path inside the private bucket
  mimeType       String?
  sizeBytes      Int?
  deleteAfter    DateTime?
  createdAt      DateTime @default(now())

  verification Verification @relation(fields: [verificationId], references: [id], onDelete: Cascade)

  @@index([verificationId])
}


enum CategoryGroup {
  RESIDENTIAL
  COMMERCIAL
  LAND
}

enum TransactionType {
  FOR_SALE
  FOR_RENT
  SHORT_TERM
  LEASE
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  SUSPENDED
  RESERVED
  RENTED
  SOLD
  EXPIRED
  ARCHIVED
}

enum Furnishing {
  UNFURNISHED
  SEMI_FURNISHED
  FURNISHED
}

enum PricePeriod {
  YEAR
  MONTH
  DAY
  ONE_OFF
}

enum MediaKind {
  IMAGE
  VIDEO
  FLOOR_PLAN
}

model PropertyCategory {
  id            String        @id @default(cuid())
  slug          String        @unique
  name          String
  categoryGroup CategoryGroup
  hasRooms      Boolean       @default(true) // false for land: hides bedrooms, bathrooms, toilets
  active        Boolean       @default(true)
  sortOrder     Int           @default(0)

  properties Property[]
}

model Amenity {
  id        String  @id @default(cuid())
  slug      String  @unique
  name      String
  active    Boolean @default(true)
  sortOrder Int     @default(0)

  properties Property[]
}

model Property {
  id              String          @id @default(cuid())
  title           String
  description     String
  categoryId      String
  transactionType TransactionType
  listingStatus   ListingStatus   @default(DRAFT)

  postedById String  @db.Uuid
  agencyId   String?

  state            String
  lga              String?
  city             String
  neighbourhood    String?
  streetAddress    String?
  latitude         Float?
  longitude        Float?
  hideExactAddress Boolean @default(true)

  bedrooms      Int?
  bathrooms     Int?
  toilets       Int?
  parkingSpaces Int?
  sizeSqm       Float?
  furnishing    Furnishing?
  yearBuilt     Int?

  priceNaira        BigInt
  pricePeriod       PricePeriod
  negotiable        Boolean     @default(false)
  additionalCharges Json?       // e.g. [{ "label": "Caution fee", "amount": 200000 }]

  publishedAt     DateTime?
  expiresAt       DateTime?
  lastConfirmedAt DateTime?
  reviewedById    String?   @db.Uuid
  reviewedAt      DateTime?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category PropertyCategory @relation(fields: [categoryId], references: [id])
  postedBy User             @relation(fields: [postedById], references: [id])
  agency   Agency?          @relation(fields: [agencyId], references: [id])
  amenities Amenity[]
  media     PropertyMedia[]
  favorites Favorite[]
  conversations Conversation[]

  @@index([listingStatus, transactionType, state, city])
  @@index([postedById])
  @@index([categoryId])
  @@index([priceNaira])
}

model PropertyMedia {
  id         String    @id @default(cuid())
  propertyId String
  kind       MediaKind @default(IMAGE)
  storageKey String
  sortOrder  Int       @default(0)
  isCover    Boolean   @default(false)
  mimeType   String?
  sizeBytes  Int?
  createdAt  DateTime  @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, sortOrder])
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String   @db.Uuid
  propertyId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([userId, createdAt])
}

enum EnquiryStatus {
  NEW
  READ
  RESPONDED
  CLOSED
}

model Conversation {
  id              String        @id @default(cuid())
  propertyId      String
  clientId        String        @db.Uuid
  recipientId     String        @db.Uuid
  status          EnquiryStatus @default(NEW)
  clientUnread    Boolean       @default(false)
  recipientUnread Boolean       @default(true)
  lastMessageAt   DateTime      @default(now())
  createdAt       DateTime      @default(now())

  property  Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  client    User      @relation("ConversationClient", fields: [clientId], references: [id])
  recipient User      @relation("ConversationRecipient", fields: [recipientId], references: [id])
  messages  Message[]

  @@unique([propertyId, clientId])
  @@index([clientId, lastMessageAt])
  @@index([recipientId, lastMessageAt])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String   @db.Uuid
  body           String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String    @db.Uuid
  type      String
  title     String
  body      String?
  href      String?
  refKey    String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, refKey])
  @@index([userId, readAt, createdAt])
}

model Follow {
  id         String   @id @default(cuid())
  followerId String   @db.Uuid
  targetType String
  targetId   String
  createdAt  DateTime @default(now())

  follower User @relation(fields: [followerId], references: [id], onDelete: Cascade)

  @@unique([followerId, targetType, targetId])
  @@index([targetType, targetId])
}